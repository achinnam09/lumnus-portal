generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecruitmentCycle {
  id           Int           @id @default(autoincrement())
  label        String        @unique
  events       Event[]
  applicants   Applicant[]
  applications Application[]
  infoNightComments       InfoNightComment[]
  speedNetworkingComments SpeedNetworkingComment[]
  caseStudyScores         CaseStudyScore[]
  assessmentCenterScores  AssessmentCenterScore[]
}

model Applicant {
  id               Int              @id @default(autoincrement())
  name             String
  email            String
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  attendances      Attendance[]

  applications Application[]

  infoNightComments       InfoNightComment[]
  speedNetworkingComments SpeedNetworkingComment[]
  caseStudyScores         CaseStudyScore[]
  assessmentCenterScores  AssessmentCenterScore[]

  @@unique([email, cycleId])
}

model Event {
  id               Int              @id @default(autoincrement())
  name             String
  date             DateTime
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  attendances      Attendance[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  applicantId Int
  eventId     Int
  timestamp   DateTime @default(now())

  applicant Applicant @relation(fields: [applicantId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])

  @@unique([applicantId, eventId]) // prevents double check-in for an event
}

enum Track {
  Strategy
  DataAnalytics
}

model Application {
  id Int @id @default(autoincrement())

  applicantId Int       
  applicant   Applicant @relation(fields: [applicantId], references: [id])

  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])

  year        String
  email       String
  major       String
  minor       String?
  track       Track
  essay1      String
  essay2      String
  resumeUrl   String
  headshotUrl String
  heardFrom   String
  createdAt   DateTime @default(now())

  @@unique([applicantId, cycleId]) // Enforces one app per cycle per applicant
}

model InfoNightComment {
  id          Int       @id @default(autoincrement())
  applicantId Int
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  proctorName  String
  proctorEmail String
  flag         String?
  comment      String
  createdAt    DateTime  @default(now())
  @@unique([applicantId, proctorEmail, cycleId])
}

model SpeedNetworkingComment {
  id          Int       @id @default(autoincrement())
  applicantId Int
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  proctorName  String
  proctorEmail String
  flag         String?
  comment      String
  createdAt    DateTime  @default(now())
  @@unique([applicantId, proctorEmail, cycleId])
}

model CaseStudyScore {
  id          Int       @id @default(autoincrement())
  applicantId Int
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  proctorName  String
  proctorEmail String
  communicationScore Float
  analyticalScore    Float
  personableScore    Float
  commitmentScore    Float
  totalScore         Float
  communicationComment String?
  analyticalComment    String?
  personableComment    String?
  commitmentComment    String?
  flag         String?
  flagComment  String?
  createdAt    DateTime  @default(now())
  @@unique([applicantId, proctorEmail, cycleId])
}

model AssessmentCenterScore {
  id               Int              @id @default(autoincrement())
  applicantId      Int
  applicant        Applicant        @relation(fields: [applicantId], references: [id])
  cycleId          Int
  recruitmentCycle RecruitmentCycle @relation(fields: [cycleId], references: [id])
  proctorName      String
  proctorEmail     String
  station          String
  communicationScore   Float
  analyticalScore      Float
  personableScore      Float
  commitmentScore      Float
  totalScore           Float
  communicationComment String?
  analyticalComment    String?
  personableComment    String?
  commitmentComment    String?
  flag             String?
  flagComment      String?
  createdAt        DateTime @default(now())
  @@unique([applicantId, proctorEmail, station, cycleId])
}
